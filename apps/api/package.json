{
  "name": "@nestle-ghana/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "prisma generate --schema prisma/schema.prisma",
    "build": "tsc --project tsconfig.json && mkdir -p dist/generated && cp -R src/generated/prisma dist/generated/",
    "dev": "tsx watch src/main.ts",
    "docs:openapi": "tsx src/scripts/export-openapi.ts",
    "lint": "eslint src --ext .ts",
    "seed:regions": "tsx src/scripts/seed-regions.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.19",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/websockets": "^11.1.19",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/pdfkit": "^0.17.6",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.10.0",
    "cron": "^4.4.0",
    "ioredis": "^5.10.1",
    "luxon": "^3.7.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.3",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "typescript": "^5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.4"
  }
}
