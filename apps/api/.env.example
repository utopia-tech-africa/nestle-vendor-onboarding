# Cloudinary (attendance selfies + outlet photos). When unset, images fall back to database BYTEA storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend — ops alerts + attendance digest. Required in staging/production for email delivery.
RESEND_API_KEY=
# e.g. Nestlé Ghana <notifications@your-verified-domain.com>
RESEND_FROM_EMAIL=

# Optional: applied to seeded supervisor + admin emails (pnpm exec tsx src/scripts/seed-test-users.ts)
SEED_ALERT_EMAIL=

# Minutes after a clock-in before a promoter must GPS+selfie clock in again (default 30).
ATTENDANCE_RECHECK_MINUTES=30
